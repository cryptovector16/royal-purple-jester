    <string name="motive_1">A debt to the guild that the crown would erase</string>
    <string name="motive_2">A brother buried without a name or a stone</string>
    <string name="motive_3">The gallery key, promised and never given</string>
    <string name="motive_4">A letter of blood sworn to a foreign house</string>
    <string name="motive_5">The council seat that went to a younger hand</string>
    <string name="motive_6">A forged line in the register of births</string>
    <string name="motive_7">Three winters of silence bought with gold</string>
    <string name="motive_8">A promise made to the old king on his last night</string>

    <string name="topic_truth_1">The signet never left the vault before dawn.</string>
    <string name="topic_lie_1">The signet lay on the council table at midnight.</string>
    <string name="topic_truth_2">One candle burned in the gallery all night.</string>
    <string name="topic_lie_2">The gallery stood in complete darkness all night.</string>
    <string name="topic_truth_3">The debt to the guild was paid in full before the vote.</string>
    <string name="topic_lie_3">The guild is still owed three hundred marks.</string>
    <string name="topic_truth_4">The sealed letter was burned before the council sat.</string>
    <string name="topic_lie_4">The sealed letter is still locked in the scriptorium.</string>
    <string name="topic_truth_5">The east door was barred from the inside.</string>
    <string name="topic_lie_5">The east door stood open the whole evening.</string>
    <string name="topic_truth_6">The jester wore the burgundy mask at supper.</string>
    <string name="topic_lie_6">The jester went unmasked through the whole supper.</string>
    <string name="topic_truth_7">Every claimant swore the oath before the council.</string>
    <string name="topic_lie_7">Two claimants refused to swear the oath.</string>
    <string name="topic_truth_8">The ring of keys hung by the hearth all night.</string>
    <string name="topic_lie_8">The ring of keys vanished before the bell.</string>

    <string name="neutral_1">The hall was colder than any winter I remember.</string>
    <string name="neutral_2">I counted the chairs twice and found them all filled.</string>
    <string name="neutral_3">The wine was poured by a servant I did not know.</string>
    <string name="neutral_4">No bell rang between the second hour and the third.</string>
    <string name="neutral_5">The drapes were drawn against the river wind.</string>
    <string name="neutral_6">I have served this house longer than most of you have lived.</string>
    <string name="neutral_7">The council scribe wrote nothing down after midnight.</string>
    <string name="neutral_8">There were four cups on the table and five seats.</string>

