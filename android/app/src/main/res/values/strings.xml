    <string name="rules_title">INSTRUCTIONS OF THE JESTER</string>
    <string name="rule_title_1">SPEND A QUESTION</string>
    <string name="rule_body_1">DEAL CLAIM turns one sealed testimony face up. Select a mask first to choose who speaks.</string>
    <string name="rule_title_2">MARK THE SEALS</string>
    <string name="rule_body_2">Tap a wax seal to cycle it: unmarked, marked true, marked false. Marks cost nothing.</string>
    <string name="rule_title_3">LOCK A CONTRADICTION</string>
    <string name="rule_body_3">Mark exactly two core claims, then LOCK PAIR. A real contradiction earns insight, a false one costs patience.</string>
    <string name="rule_title_4">SEAL OF TRUTH</string>
    <string name="rule_body_4">Three insight unmasks the selected courtier for certain and settles every claim they ever spoke.</string>
    <string name="rule_title_5">NAME THE HEIR</string>
    <string name="rule_body_5">ACCUSE before the questions run out. When they do, the council calls the vote without you.</string>
    <string name="rules_footer">A MASKED COURTIER SPEAKS ONLY FALSEHOODS. AN UNMASKED ONE SPEAKS ONLY TRUTH.</string>

